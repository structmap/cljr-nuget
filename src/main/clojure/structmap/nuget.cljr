(ns structmap.nuget
  (:import [System Environment Environment+SpecialFolder]
           [System.Globalization CompareOptions CultureInfo]
           [System.Runtime.Loader AssemblyLoadContext]
           [System.IO Directory Path])
  (:require [clojure.string :as string]))

(def macos? (OperatingSystem/IsMacOS))
(def windows? (OperatingSystem/IsWindows))
(def linux? (OperatingSystem/IsLinux))

(def pwd (Directory/GetCurrentDirectory))

(def home (Environment/GetFolderPath Environment+SpecialFolder/UserProfile))

(def cmp
  (StringComparer/Create CultureInfo/InvariantCulture CompareOptions/NumericOrdering))

(def nuget
  (->> (string/join Path/DirectorySeparatorChar [home ".nuget"])
       (new System.IO.DirectoryInfo)
       file-seq
       (filter (partial instance? System.IO.FileInfo))
       (filter #(string/ends-with? (.Name %) ".dll"))
       (group-by #(cond (string/includes? (.FullName %) "net462") :net462
                        (string/includes? (.FullName %) "net481") :net481
                        (string/includes? (.FullName %) "netcoreapp") :netcoreapp
                        (string/includes? (.FullName %) "netstandard") :netstandard
                        :default :net))
       ((juxt :net462 :net481 :netcoreapp :netstandard :net))
       (mapcat (fn [dlls] (sort-by #(.FullName %) (fn [x y] (.Compare cmp x y)) dlls)))
       (map (juxt #(.Name %) #(.FullName %)))
       (into {})))

(defn default-load-file
  "Like assembly-load-file but for default AssemblyLoadContext."
  [dll]
  (let [alc AssemblyLoadContext/Default]
    (.LoadFromAssemblyPath alc dll)))

(defn default-load
  "Like assembly-load but for default AssemblyLoadContext."
  [x]
  (some-> x (str ".dll") nuget assembly-load-file))

nil
